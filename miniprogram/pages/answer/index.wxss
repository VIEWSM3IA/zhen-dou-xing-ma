.update-banner {
  margin-bottom: 28rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: #eef2f5;
  color: #4d5661;
  font-size: 25rpx;
}

.proposal-card {
  margin-top: 32rpx;
}

.proposal-content {
  color: #11151a;
  font-size: 38rpx;
  font-weight: 650;
  line-height: 1.55;
}

.choice-heading {
  margin-top: 44rpx;
  margin-bottom: 18rpx;
  color: #5f6771;
  font-size: 26rpx;
  font-weight: 600;
}

.choice-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.choice-card {
  display: flex;
  width: 100%;
  margin: 0;
  min-height: 132rpx;
  box-sizing: border-box;
  padding: 26rpx 26rpx 26rpx 28rpx;
  align-items: center;
  justify-content: space-between;
  border: 2rpx solid #e2e6ea;
  border-radius: 24rpx;
  background: #ffffff;
  line-height: normal;
  text-align: left;
}

.choice-card--selected {
  border-color: #171a1f;
  box-shadow: inset 0 0 0 1rpx #171a1f;
}

.choice-main {
  flex: 1;
  padding-right: 24rpx;
}

.choice-label {
  color: #15181d;
  font-size: 32rpx;
  font-weight: 650;
}

.choice-hint {
  margin-top: 8rpx;
  color: #7a818b;
  font-size: 25rpx;
  line-height: 1.45;
}

.choice-dot {
  display: flex;
  width: 36rpx;
  height: 36rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #bcc2c9;
  border-radius: 50%;
}

.choice-card--selected .choice-dot {
  border-color: #171a1f;
}

.choice-dot-inner {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #171a1f;
}

.privacy-note {
  margin-top: 20rpx;
  color: #9298a0;
  font-size: 24rpx;
  line-height: 1.55;
  text-align: center;
}

.privacy-promise {
  margin-top: 26rpx;
  color: #5f6771;
  font-size: 27rpx;
  line-height: 1.6;
}

.compact-state {
  margin-top: 40rpx;
}
